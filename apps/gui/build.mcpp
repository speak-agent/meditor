import mcpp;
import huxerui.rules;
import std;
int main() {
    const auto os = std::string_view(mcpp::target_os());
    const auto environment = std::string_view(mcpp::target_env());
    // Desktop applications inherit these files from the native CLI artifact.
    if (os == "android" || environment == "android" || os == "ios" || os == "emscripten") {
        const auto root = std::filesystem::path(mcpp::manifest_dir()) / "../..";
        mcpp::deploy((root / "LICENSE").string().c_str(), "licenses/meditor");
        mcpp::deploy((root / "LICENSING.md").string().c_str(), "licenses/meditor");
    }
    return huxerui::rules::configure({
        .target = "meditor-gui",
        .sources = {"src/app.cppm", "../../modules/ui/workbench.cppm", "../../modules/ui/workbench.cpp", "../../modules/ui/editor.cppm", "../../modules/ui/editor.cpp"},
        .bundle_name = "meditor",
        .bundle_identifier = "org.speakagent.meditor",
        .installer = {.target = "meditor-gui", .version = "0.0.1", .upgrade_code = "81092ED7-605E-4435-B6A3-4DD04682CE21"},
    }) ? 0 : 1;
}
